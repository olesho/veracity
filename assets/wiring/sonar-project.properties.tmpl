# SonarQube scan config for this project. Seeded once by veracity; yours to edit.
# sonar.projectKey must be unique across the shared SonarQube instance.
# Scans run against the self-hosted server (default http://localhost:9000) using
# SONAR_TOKEN — a LOCAL API credential; nothing is sent off this machine.
sonar.projectKey={{.Name}}
sonar.projectName={{.Name}}
sonar.sources=.
sonar.exclusions=**/node_modules/**,**/dist/**,**/build/**,**/*.min.js,**/vendor/**
sonar.sourceEncoding=UTF-8
