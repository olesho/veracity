name: ci
on:
  push:
  pull_request:

# The runner comes from the repository variable CI_RUNNER, as JSON: unset, it
# is GitHub's ubuntu-latest; ["self-hosted","LABEL"] picks self-hosted runners
# (see docs/ci-setup.md).
jobs:
  veracity-ci:
    runs-on: ${{"{{"}} fromJSON(vars.CI_RUNNER || '"ubuntu-latest"') }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # Go is always required to install the pinned veracity binary itself.
      - uses: actions/setup-go@v5
        with:
          # A self-hosted runner keeps Go's caches on its own disk; saving them
          # to GitHub's cache only costs time there.
          cache: ${{"{{"}} vars.CI_RUNNER == '' }}
{{- if .HasGo}}
          go-version-file: go.mod
{{- else}}
          go-version: "1.26"
{{- end}}
{{- if .HasTS}}
      # pnpm version comes from package.json "packageManager"; passing it here
      # too makes pnpm/action-setup error ("Multiple versions of pnpm specified").
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
{{- end}}
{{- if .HasPython}}
      - uses: astral-sh/setup-uv@v5
{{- end}}
      - name: Install pinned veracity
        run: go install github.com/olesho/veracity/cmd/veracity@$(cat .veracity-version)
      - name: Install dependencies
        run: veracity bootstrap
      - name: Install pinned analyzers
        run: veracity install-tools
      - name: veracity ci
        run: veracity ci
